# Copy to .env and fill in. Never commit .env.

# Local: must match the credentials in ../.env. Atlas: your mongodb+srv:// URI.
MONGODB_URI=mongodb://<user>:<password>@localhost:27018/?directConnection=true&authSource=admin
MONGODB_DB=noema

# Signs session tokens. Required, 32+ characters: openssl rand -hex 32
JWT_SECRET=

SESSION_MINUTES=10080
CORS_ORIGINS=http://localhost:5173
# true when served over HTTPS (always in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
